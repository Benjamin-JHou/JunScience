{
  "appId": "com.junscience.desktop",
  "productName": "JunScience",
  "executableName": "junscience",
  "electronVersion": "28.3.3",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "Benjamin-JHou",
    "repo": "JunScience"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.education",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
